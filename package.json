{
  "name": "phoevents-videos",
  "version": "1.0.0",
  "private": true,
  "description": "Vidéos motion design PhoEvents générées avec Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render:reel": "remotion render Reel videos/phoevents-reel.mp4",
    "render:sans-musique": "remotion render ReelSansMusique videos/phoevents-reel-sans-musique.mp4",
    "render:voix": "remotion render ReelVoix videos/phoevents-reel-voix-homme.mp4",
    "render:post": "remotion render Post videos/phoevents-post.mp4",
    "render:intro": "remotion render Intro videos/phoevents-intro.mp4",
    "render:all": "npm run render:reel && npm run render:sans-musique && npm run render:voix && npm run render:post && npm run render:intro && npm run render:cover && sh tools/master_audio.sh videos/*.mp4",
    "render:cover": "remotion still Cover videos/phoevents-reel-couverture.png --frame=80"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
